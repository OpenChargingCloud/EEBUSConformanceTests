<!--
  Common build settings for all EEBUSConformanceTests projects.

  Note: submodules under "libs/" are shielded from this file by libs/Directory.Build.props.
-->
<Project>

  <PropertyGroup>

    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Protocol conformance code: no sloppiness tolerated in our own sources. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>

    <NeutralLanguage>en</NeutralLanguage>
    <InvariantGlobalization>true</InvariantGlobalization>

    <Company>GraphDefined GmbH</Company>
    <Authors>GraphDefined GmbH</Authors>
    <Copyright>Copyright © 2014-2026 GraphDefined GmbH</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/OpenChargingCloud/EEBUSConformanceTests</RepositoryUrl>

  </PropertyGroup>

  <!-- Test projects: same everywhere, so they are declared once. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('_Tests'))">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('_Tests'))">
    <!-- FakeTimeProvider: protocol timing is tested deterministically, never against the wall clock. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.10.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>

</Project>
